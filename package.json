{
  "name": "napcat-plugin-pixiv",
  "plugin": "Pixiv 搜索与推荐",
  "version": "1.4.0",
  "type": "module",
  "main": "index.mjs",
  "description": "NapCat Pixiv 搜索与推荐插件，支持 SnowLuma/OneBot v11 零配置 Docker 自动发现、systemd 守护和多图合并转发",
  "author": "ShiYuPIay",
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.19.0",
  "keywords": [
    "napcat",
    "snowluma",
    "onebot",
    "pixiv",
    "qq"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.18.0"
  },
  "napcat": {
    "tags": ["图片", "搜索", "娱乐"],
    "minVersion": "4.14.0",
    "homepage": "https://github.com/ShiYuPIay/napcat-plugin-pixiv"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "0.25.12",
    "typescript": "^5.9.3",
    "vite": "6.4.1"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "setup:snowluma": "npm run doctor:snowluma",
    "doctor:snowluma": "npm run build && node dist/snowluma.mjs --doctor --auto",
    "start:snowluma": "npm run build && node dist/snowluma.mjs --auto",
    "deploy:snowluma": "bash scripts/deploy-snowluma.sh",
    "service:status": "bash scripts/service-snowluma.sh status",
    "service:restart": "bash scripts/service-snowluma.sh restart",
    "service:logs": "bash scripts/service-snowluma.sh logs",
    "service:follow": "bash scripts/service-snowluma.sh follow",
    "snowluma": "node dist/snowluma.mjs"
  }
}
