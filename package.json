{
  "name": "napcat-plugin-pixiv",
  "plugin": "Pixiv 搜索与推荐",
  "version": "1.2.0",
  "type": "module",
  "main": "index.mjs",
  "description": "NapCat Pixiv 搜索与推荐插件，支持 SnowLuma/OneBot v11 独立运行模式",
  "author": "ShiYuPIay",
  "license": "AGPL-3.0-only",
  "keywords": [
    "napcat",
    "snowluma",
    "onebot",
    "pixiv",
    "qq"
  ],
  "engines": {
    "node": ">=22"
  },
  "napcat": {
    "tags": ["图片", "搜索", "娱乐"],
    "minVersion": "4.14.0",
    "homepage": "https://github.com/ShiYuPIay/napcat-plugin-pixiv"
  },
  "dependencies": {
    "napcat-types": "0.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "snowluma": "node dist/snowluma.mjs"
  }
}
